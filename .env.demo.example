# 复制为 .env.demo 后使用：
#   copy .env.demo.example .env.demo
#   docker compose --env-file .env.demo -f docker-compose.demo.yml up --build

MYSQL_DATABASE=agent_demo
MYSQL_ROOT_PASSWORD=demo-root-change-me

# Java 与 Agent 共用的内部 HMAC 密钥，必须一致
AGENT_INTERNAL_SECRET=demo-internal-secret-change-me
# HITL 恢复令牌密钥
AGENT_RESUME_SECRET=demo-resume-secret-change-me
# Java 调业务后端的服务令牌
AGENT_SERVICE_AUTH_TOKEN=demo-agent-service

# 0 = 使用真实模型；1 = 离线替身（默认 1，保证没有 Key 也能演示）
AGENT_OFFLINE_RAG=1
AGENT_DISABLE_LLM=1
AGENT_OPENAI_API_KEY=
AGENT_OPENAI_BASE_URL=https://api.siliconflow.cn/v1
AGENT_OPENAI_MODEL=Qwen/Qwen3-8B
AGENT_EMBEDDING_MODEL=BAAI/bge-m3
