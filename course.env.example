# 跨境电商 Agent 故事课统一模型配置示例
#
# 第一次运行代码时，把本文件复制为：
#   code/agent-course-versions/course.env
# 后续每一课的 Agent 后端都会优先读取同一份 course.env。
#
# 默认按硅基流动 OpenAI-compatible 接口预填模型参数。
# 运行时通常只需要把 AGENT_OPENAI_API_KEY 改成自己的 Key。

AGENT_OPENAI_API_KEY=你的模型平台 Key
AGENT_OPENAI_BASE_URL=https://api.siliconflow.cn/v1
AGENT_OPENAI_MODEL=Qwen/Qwen3-8B
AGENT_CLASSIFIER_MODEL=Qwen/Qwen3-8B
AGENT_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
AGENT_RAG_RERANK_ENABLED=true
AGENT_RAG_RERANK_MODEL=Qwen/Qwen3-Reranker-8B
AGENT_RAG_RERANK_BASE_URL=https://api.siliconflow.cn/v1

# ===== 生产化开关（本地调试保持默认即可）=====
AGENT_ENV=dev
AGENT_AUTH_MODE=off
AGENT_INTERNAL_SECRET=
AGENT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AGENT_RESUME_TOKEN_MODE=legacy
AGENT_RESUME_SECRET=
AGENT_STRICT_BUSINESS_RECHECK=0

# 持久化与审批
AGENT_STATE_BACKEND=memory
# 本地演示可用 SQLite；生产必须换成 MySQL
AGENT_DATABASE_URL=sqlite:///./agent_state.db
# 生产示例：mysql+pymysql://user:password@127.0.0.1:3306/ecommerce_agent?charset=utf8mb4
AGENT_APPROVAL_MODE=legacy

